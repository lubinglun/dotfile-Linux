" ============ vim-plug 配置开始 ============
call plug#begin('~/.vim/plugged')

" === 1. 外观美化 ===
Plug 'vim-airline/vim-airline'              " 状态栏美化
Plug 'vim-airline/vim-airline-themes'       " 状态栏主题
Plug 'morhetz/gruvbox'                      " gruvbox 配色方案
Plug 'dracula/vim', { 'as': 'dracula' }     " dracula 配色方案
" === 2. 文件管理 ===
Plug 'preservim/nerdtree'                   " 文件树
Plug 'Xuyuanp/nerdtree-git-plugin'          " NERDTree 显示 git 状态
Plug 'ryanoasis/vim-devicons'               " 文件图标(需要 Nerd Font)
Plug 'junegunn/fzf', { 'do': { -> fzf#install() } }  " 模糊搜索
Plug 'junegunn/fzf.vim'                     " fzf vim 集成

" === 3. 代码编辑 ===
Plug 'tpope/vim-commentary'                 " 快速注释 gcc
Plug 'tpope/vim-surround'                   " 快速修改包围符号
Plug 'jiangmiao/auto-pairs'                 " 自动补全括号
Plug 'preservim/nerdcommenter'              " 强大的注释工具
Plug 'terryma/vim-multiple-cursors'         " 多光标编辑

" === 4. Git 集成 ===
Plug 'tpope/vim-fugitive'                   " Git 命令集成
Plug 'airblade/vim-gitgutter'               " 显示 git diff

" === 5. 代码补全与语法 ===
"Plug 'neoclide/coc.nvim', {'branch': 'release'}  " 代码补全引擎
"Plug 'dense-analysis/ale'                   " 异步语法检查
Plug 'sheerun/vim-polyglot'                 " 多语言语法高亮

" === 6. 代码导航 ===
Plug 'preservim/tagbar'                     " 代码结构预览
Plug 'easymotion/vim-easymotion'            " 快速跳转

" === 7. 实用工具 ===
Plug 'mhinz/vim-startify'                   " 启动页面
Plug 'junegunn/vim-easy-align'              " 对齐工具
Plug 'tpope/vim-repeat'                     " 增强 . 重复命令

call plug#end()
" ============ vim-plug 配置结束 ============

" ============ 插件配置 ============

" --- 配色方案 ---
syntax enable
set background=dark
colorscheme gruvbox
" colorscheme dracula  " 或使用 dracula

" --- airline 配置 ---
let g:airline#extensions#tabline#enabled = 1
let g:airline_powerline_fonts = 1
let g:airline_theme='gruvbox'

" --- NERDTree 配置 ---
" F2 打开/关闭文件树
nnoremap <F2> :NERDTreeToggle<CR>
" 显示隐藏文件
let NERDTreeShowHidden=1
" 忽略文件
let NERDTreeIgnore=['\.pyc$', '\.git$', 'node_modules']
" 窗口宽度
let NERDTreeWinSize=30

" --- vim-commentary 配置 ---
" gcc 注释当前行
" gc + 移动命令注释多行
" 可视模式下 gc 注释选中内容

" --- fzf 配置 ---
" Ctrl+p 搜索文件
nnoremap <C-p> :Files<CR>
" Ctrl+f 搜索内容
nnoremap <C-f> :Rg<CR>
" 搜索 Buffer
nnoremap <Leader>b :Buffers<CR>

" --- vim-gitgutter 配置 ---
set updatetime=100
let g:gitgutter_max_signs = 500

" --- Tagbar 配置 ---
" F3 打开/关闭代码结构
nnoremap <F3> :TagbarToggle<CR>
let g:tagbar_width = 30
let g:tagbar_autofocus = 1

" --- EasyMotion 配置 ---
" <Leader><Leader>w 跳转到单词
" <Leader><Leader>f{char} 跳转到字符
let g:EasyMotion_smartcase = 1

" --- vim-easy-align 配置 ---
" 可视模式下按 Enter 然后输入对齐符号
xmap ga <Plug>(EasyAlign)
nmap ga <Plug>(EasyAlign)

" --- coc.nvim 基础配置 ---
" Tab 补全
" inoremap <silent><expr> <TAB>
"       \ coc#pum#visible() ? coc#pum#next(1) :
"       \ CheckBackspace() ? "\<Tab>" :
"       \ coc#refresh()

" inoremap <expr><S-TAB> coc#pum#visible() ? coc#pum#prev(1) : "\<C-h>"

" " 回车确认
" inoremap <silent><expr> <CR> coc#pum#visible() ? coc#pum#confirm()
"                               \: "\<C-g>u\<CR>\<c-r>=coc#on_enter()\<CR>"
" " 辅助函数
" function! CheckBackspace() abort
"   let col = col('.') - 1
"   return !col || getline('.')[col - 1]  =~# '\s'
" endfunction
" ============ 基础配置 ============
set number              " 显示行号
set cursorline          " 高亮当前行
set showcmd             " 显示命令
set wildmenu            " 命令行补全
set hlsearch            " 高亮搜索
set incsearch           " 增量搜索
set ignorecase          " 搜索忽略大小写
set smartcase           " 智能大小写
set expandtab           " Tab 转空格
set tabstop=4           " Tab 宽度
set shiftwidth=4        " 缩进宽度
set autoindent          " 自动缩进
set mouse=a             " 启用鼠标
set encoding=utf-8      " 编码
set clipboard=unnamed   " 使用系统剪贴板

